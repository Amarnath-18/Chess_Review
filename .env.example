# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=chess
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chess

# Analysis hard caps (server-side; requests cannot exceed these)
MAX_DEPTH=22
MAX_NODES=5000000
MAX_PLIES=300
MAX_MULTIPV=5
# A job may run for max(this, JOB_SECONDS_PER_POSITION x positions); longer jobs are stopped
ANALYSIS_JOB_TIMEOUT_SECONDS=600
JOB_SECONDS_PER_POSITION=15
DEFAULT_DEPTH=16
ENGINE_THREADS=1
ENGINE_HASH_MB=128
MAX_SECONDS_PER_POSITION=30

# Job queue
MAX_ACTIVE_JOBS_PER_USER=2
MAX_QUEUE_LENGTH=50
JOB_MAX_ATTEMPTS=2
# A running job whose worker has not reported progress for this long is requeued
JOB_STALE_SECONDS=120

# Request and usage limits
MAX_REQUEST_BYTES=1500000
MAX_GAMES_PER_USER=5000
# New anonymous sessions allowed per IP address per hour. 0 = unlimited (fine for local use);
# set something like 30 when the app is public.
SESSIONS_PER_IP_PER_HOUR=0

# Sessions / privacy. Set COOKIE_SECURE=true when serving over HTTPS (required when public).
COOKIE_SECURE=false
RETENTION_DAYS=30
# How often the worker checks for data to delete (seconds), and the most games one PGN export may hold
RETENTION_PURGE_INTERVAL_SECONDS=3600
EXPORT_MAX_GAMES=5000

# Defaults for users who have not set their own (Settings page)
DEFAULT_MULTIPV=3
DEFAULT_IMPORT_COUNT=20

# Importing from Chess.com / Lichess (public APIs only)
# Chess.com asks API clients to identify themselves; put a contact here if you can.
EXTERNAL_USER_AGENT=ChessReviewLab/0.1 (personal project; contact: you@example.com)

# Production compose only (docker-compose.prod.yml)
# WEB_BIND=127.0.0.1   # address the web server listens on; 0.0.0.0 only behind an HTTPS proxy
# WEB_PORT=8080
# API_WORKERS=1
