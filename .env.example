# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=chess
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chess

# Analysis hard caps (server-side; requests cannot exceed these)
MAX_DEPTH=22
MAX_NODES=5000000
MAX_PLIES=300
ANALYSIS_JOB_TIMEOUT_SECONDS=600
DEFAULT_DEPTH=16
ENGINE_THREADS=1
ENGINE_HASH_MB=128
MAX_SECONDS_PER_POSITION=30

# Job queue
MAX_ACTIVE_JOBS_PER_USER=2
MAX_QUEUE_LENGTH=50
JOB_MAX_ATTEMPTS=2
# A running job whose worker has not reported progress for this long is requeued
JOB_STALE_SECONDS=120

# Sessions / privacy
COOKIE_SECURE=false
RETENTION_DAYS=30
